# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------
.pipeline-test

# Local CARTA 1mpp validation outputs (diagnostic only; never commit)
diag_carta_1mpp/

# Tutorial downloads / outputs (multi-GB example data, never committed)
example-data/
tutorial-*-output/

# ---------------------------------------------------------------------------
# Re-include small committed test fixtures (overrides bio-image extensions
# above so tests/data/tiny_slide.zarr/ and similar can be committed).
# Still keep bytecode caches out, even under tests/data/.
# ---------------------------------------------------------------------------
!tests/data/
!tests/data/**
tests/data/**/__pycache__/
tests/data/**/*.pyc
patch_legend_compare/
